# Copy to .env and adjust if needed. Vite loads files from the /env folder (see vite.config.js).
VITE_API_BASE_URL=https://api.iontrip.com

# Tour packages: https://api.iontrip.com/admin/tour-packages
VITE_PUBLIC_API_BASE_URL=https://api.iontrip.com
VITE_TOUR_API_BASE_URL=https://api.iontrip.com
VITE_TOUR_PACKAGES_PATH=/admin/tour-packages
VITE_TOUR_PACKAGE_COUNTRY_PATH=/tour-package-country
VITE_TOUR_PACKAGE_COUNTRY_SEARCH_PATH=/tour-package-country/search
VITE_TOUR_PACKAGE_ENQUIRIES_PATH=/admin/tour-package-enquiries
VITE_CATEGORY_ADMIN_PATH=/catagory/admin
